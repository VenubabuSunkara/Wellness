@model WeightRequestViewModel

@{
    ViewData["Title"] = "Create New Weight Metrics";
}

<div class="container mt-4">
    <h2>Weight Metrics</h2>
    <form asp-action="SaveHealthMetrics" method="post">
        @Html.AntiForgeryToken()

        <div class="row">
            <!-- Weight and Height -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Weight" class="form-label">Weight (kg)</label>
                    <input asp-for="Weight" class="form-control" type="number" step="any" min="0" />
                    <span asp-validation-for="Weight" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Height" class="form-label">Height (cm)</label>
                    <input asp-for="Height" class="form-control" type="number" step="any" min="0" />
                    <span asp-validation-for="Height" class="text-danger"></span>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <!-- Body Composition -->
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="BodyFatPercentage" class="form-label">Body Fat %</label>
                    <input asp-for="BodyFatPercentage" class="form-control" type="number" step="any" min="0" max="100" />
                    <span asp-validation-for="BodyFatPercentage" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="MuscleMass" class="form-label">Muscle Mass (kg)</label>
                    <input asp-for="MuscleMass" class="form-control" type="number" step="any" min="0" />
                    <span asp-validation-for="MuscleMass" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="VisceralFat" class="form-label">Visceral Fat Level</label>
                    <input asp-for="VisceralFat" class="form-control" type="number" step="any" min="0" />
                    <span asp-validation-for="VisceralFat" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label asp-for="TrunkFatPercentage" class="form-label">Trunk Fat %</label>
                    <input asp-for="TrunkFatPercentage" class="form-control" type="number" step="any" min="0" max="100" />
                    <span asp-validation-for="TrunkFatPercentage" class="text-danger"></span>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <!-- Metabolic Data -->
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="BasalMetabolicRate" class="form-label">BMR (kcal/day)</label>
                    <input asp-for="BasalMetabolicRate" class="form-control" type="number" step="any" min="0" />
                    <span asp-validation-for="BasalMetabolicRate" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="MetabolicAge" class="form-label">Metabolic Age (years)</label>
                    <input asp-for="MetabolicAge" class="form-control" type="number" min="0" />
                    <span asp-validation-for="MetabolicAge" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="BMI" class="form-label">BMI</label>
                    <input asp-for="BMI" class="form-control" type="number" min="0" />
                    <span asp-validation-for="BMI" class="text-danger"></span>
                </div>
            </div>
        </div>

        <hr class="my-4" />

        <button type="submit" class="btn btn-primary">Save Weight Metrics</button>
    </form>
</div>