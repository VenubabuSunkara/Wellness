@model Wellness.Web.ViewModels.RegisterViewModel

<div class="row justify-content-center">

    <div class="col-md-5">

        <div class="card shadow">

            <div class="card-header text-center">

                <h3>Create Account</h3>

            </div>

            <div class="card-body">

                <form method="post">

                    <div class="mb-3">

                        <label>First Name</label>

                        <input asp-for="FirstName"
                               class="form-control" />

                    </div>

                    <div class="mb-3">

                        <label>Email</label>

                        <input asp-for="Email"
                               class="form-control" />

                    </div>

                    <div class="mb-3">

                        <label>Password</label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control" />

                    </div>

                    <button class="btn btn-success w-100">
                        Register
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>